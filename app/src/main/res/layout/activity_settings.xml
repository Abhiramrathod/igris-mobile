<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mc_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.03"
            android:text="@string/title_settings"
            android:textColor="@color/mc_cream"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="@string/settings_subtitle"
            android:textColor="@color/mc_text_muted"
            android:textSize="11sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:alpha="0.4"
            android:background="@color/mc_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/label_mode"
            android:textColor="@color/mc_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerMode"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_spinner"
            android:popupBackground="@color/mc_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/label_base_url"
            android:textColor="@color/mc_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_base_url_direct"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/mc_cream"
            android:textColorHint="@color/mc_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.12"
            android:text="@string/label_api_key"
            android:textColor="@color/mc_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_api_key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/mc_cream"
            android:textColorHint="@color/mc_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.12"
            android:text="@string/label_model"
            android:textColor="@color/mc_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_model"
            android:importantForAutofill="no"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="@color/mc_cream"
            android:textColorHint="@color/mc_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/label_temperature"
                    android:textColor="@color/mc_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputTemperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_temperature"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/mc_cream"
                    android:textColorHint="@color/mc_text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/label_max_tokens"
                    android:textColor="@color/mc_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputMaxTokens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_max_tokens"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="@color/mc_cream"
                    android:textColorHint="@color/mc_text_muted"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.12"
            android:text="@string/label_system_prompt"
            android:textColor="@color/mc_text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputSystemPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="@string/default_system_prompt"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/mc_cream"
            android:textColorHint="@color/mc_text_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_send"
            android:letterSpacing="0.06"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            android:textColor="@color/mc_black"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
